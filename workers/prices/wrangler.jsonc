// Tameru's price service (experimental investment prices). Deploy once with
//   cd workers/prices && npx wrangler deploy
// then attach the custom domain prices.tameru.cc in the Cloudflare dashboard
// (Workers & Pages → tameru-prices → Settings → Domains & Routes).
{
  "name": "tameru-prices",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  // Guards for Yahoo (see src/index.ts): each device, and everyone together, per minute.
  // namespace_id is any number unique to this account.
  "ratelimits": [
    { "name": "PER_CLIENT", "namespace_id": "4801", "simple": { "limit": 10, "period": 60 } },
    { "name": "OVERALL", "namespace_id": "4802", "simple": { "limit": 60, "period": 60 } }
  ]
}
